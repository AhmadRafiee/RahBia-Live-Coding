# restart policy
restart_policy=always

# MonLog domains
main_domain={{ main_domain }}
prom_sub={{ prometheus_subdomain }}
alert_sub={{ alertmanager_subdomain }}
grafana_sub={{ grafana_subdomain }}
pushgw_sub={{ pushgateway_subdomain }}

# MonLog image tag
prom_image_tag={{ prometheus_image_version }}
alert_image_tag={{ alertmanager_image_version }}
grafana_image_tag={{ grafana_image_version }}

# grafana root access
grafana_username={{ grafana_username }}
grafana_password={{ grafana_password }}
